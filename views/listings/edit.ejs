<% layout("/layouts/boilerplate") -%>
<div class="row  mt-3">
    <div class="col-8 offset-2">

   
        <h2>edit yout listing </h2>
        <form method="POST" action="/listings/<%= showAllInfo._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" name= "Listing[title]" value="<%= showAllInfo.title %>" class="form-control" required> 

                <!-- this div is for form fillup feedback -->
                <div class="valid-feedback">Title Looks Good</div> 
                <div class="invalid-feedback">Please choose a Title.</div>

            </div>
            <div class="mb-3">
                <label for="description" class="form-label">description</label>
                <textarea name="Listing[description]" class="form-control" required ><%= showAllInfo.description %></textarea>

                <!-- this div is for form fillup feedback -->
                <div class="invalid-feedback">Add a short description</div>

            </div>
            <div class="mb-3">
                Original Listing Image <br>
                <img src="<%= originalImageUrl %>" >

            </div>
            <div class="row ">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">price</label>
                    <input type="number" name="Listing[price]" class="form-control" value="<%= showAllInfo.price %>" required>
                    
                    <!-- this div is for form fillup feedback -->
                    <div class="invalid-feedback">Please neter the price.</div>

                </div>
                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">country</label>
                    <input type="text" name="Listing[country]" class="form-control" value="<%= showAllInfo.country %>" required>

                    <!-- this div is for form fillup feedback -->
                    <div class="invalid-feedback">Please enter a country</div> 

                </div>
            </div>
            <div class="mb-3">
                <label for="image" class="form-label">image</label>
                <input type="file" name="Listing[image]" class="form-control" >

            </div>
            <div class="mb-3">
                <label for="location" class="form-label">location</label>
                <input type="text" class="form-control"  name="Listing[location]" value="<%= showAllInfo.location %>" required>

                <!-- this div is for form fillup feedback -->
                <div class="invalid-feedback">Please enter the location.</div>

            </div>
            

            <button class="btn btn-dark edit-btn mt-3">Edit</button>
            <br><br><br><br>
        </form>
    </div>
</div>
    
